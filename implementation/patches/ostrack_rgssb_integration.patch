+    def build_response_target_masks(self, search_anno, score_map_shape, device=None, dtype=None):
+        if search_anno.dim() != 2 or search_anno.size(-1) != 4:
+            raise ValueError("Target-distractor margin expects search_anno with shape [B, 4].")
+        if len(score_map_shape) == 3:
+            batch, height, width = score_map_shape
+        elif len(score_map_shape) == 4:
+            batch, channels, height, width = score_map_shape
+            if channels != 1:
+                raise ValueError("Target-distractor margin expects a single-channel response map, got C={}.".format(channels))
+        else:
+            raise ValueError("Target-distractor margin expects score_map shape [B, H, W] or [B, 1, H, W].")
+        if search_anno.size(0) != batch:
+            raise ValueError(
+                "Target-distractor margin batch mismatch: search_anno={} score_map={}.".format(
+                    tuple(search_anno.shape), tuple(score_map_shape)
+                )
+            )
+
+        device = device if device is not None else search_anno.device
+        dtype = dtype if dtype is not None else search_anno.dtype
+        boxes = search_anno.to(device=device, dtype=dtype).clamp(min=0.0, max=1.0)
+        x, y, w, h = boxes.unbind(dim=-1)
+        target_scale = float(getattr(self.target_distractor_margin_cfg, "TARGET_SCALE", 1.0))
+        target_scale = max(target_scale, 1e-6)
+        cx = (x + 0.5 * w).clamp(0.0, 1.0)
+        cy = (y + 0.5 * h).clamp(0.0, 1.0)
+        tw = (w * target_scale).clamp(min=1.0 / width, max=1.0)
+        th = (h * target_scale).clamp(min=1.0 / height, max=1.0)
+        x1 = (cx - 0.5 * tw).clamp(0.0, 1.0).view(-1, 1, 1)
+        y1 = (cy - 0.5 * th).clamp(0.0, 1.0).view(-1, 1, 1)
+        x2 = (cx + 0.5 * tw).clamp(0.0, 1.0).view(-1, 1, 1)
+        y2 = (cy + 0.5 * th).clamp(0.0, 1.0).view(-1, 1, 1)
+
+        xs = (torch.arange(width, device=device, dtype=dtype) + 0.5) / width
+        ys = (torch.arange(height, device=device, dtype=dtype) + 0.5) / height
+        yy, xx = torch.meshgrid(ys, xs, indexing="ij")
+        xx = xx.view(1, height, width)
+        yy = yy.view(1, height, width)
+        target_mask = (xx >= x1) & (xx <= x2) & (yy >= y1) & (yy <= y2)
+        empty_target = target_mask.flatten(1).sum(dim=1) == 0
+        if empty_target.any():
