+        if loss_type == "l1":
+            feature_loss = F.l1_loss(degraded_feat, clean_feat)
+        elif loss_type == "mse":
+            feature_loss = F.mse_loss(degraded_feat, clean_feat)
+        else:
+            raise ValueError("Unsupported TRAIN.FEATURE_CONSISTENCY.LOSS: {}".format(loss_type))
+        if not torch.isfinite(feature_loss):
+            raise ValueError("Feature consistency loss is not finite.")
+        return feature_loss
+
+    def compute_response_consistency_loss(self, pred_dict):
+        if 'score_map' not in pred_dict:
+            available_keys = sorted(list(pred_dict.keys()))
+            raise KeyError(
+                "Response consistency requires pred_dict['score_map']. "
+                "Available output keys: {}".format(available_keys)
+            )
+        if 'score_map_clean' not in pred_dict:
+            available_keys = sorted(list(pred_dict.keys()))
+            raise KeyError(
+                "Response consistency requires pred_dict['score_map_clean']. "
+                "Available output keys: {}".format(available_keys)
+            )
+
+        degraded_response = pred_dict['score_map']
+        clean_response = pred_dict['score_map_clean']
+        if bool(getattr(self.response_consistency_cfg, "DETACH_CLEAN", True)):
+            clean_response = clean_response.detach()
+
+        loss_type = str(getattr(self.response_consistency_cfg, "LOSS", "mse")).lower()
+        if loss_type == "mse":
+            response_loss = F.mse_loss(degraded_response, clean_response)
+        elif loss_type == "l1":
+            response_loss = F.l1_loss(degraded_response, clean_response)
+        else:
+            raise ValueError("Unsupported TRAIN.RESPONSE_CONSISTENCY.LOSS: {}".format(loss_type))
+        if not torch.isfinite(response_loss):
+            raise ValueError("Response consistency loss is not finite.")
+        return response_loss
