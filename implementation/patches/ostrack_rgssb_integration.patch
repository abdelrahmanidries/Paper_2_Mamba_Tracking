index 0000000..da6a213
--- /dev/null
+++ b/lib/train/data/degradation.py
@@ -0,0 +1,178 @@
+"""Training-side synthetic degradations for OSTrack debug experiments.
+
+This is a small local adapter copied from the project degradation logic to keep
+OSTrack training independent from the main project import path. All transforms
+preserve image size and do not modify boxes or masks.
+"""
+
+from __future__ import annotations
+
+from io import BytesIO
+
+import numpy as np
+from PIL import Image
+
+
+SEVERITIES = ("mild", "medium", "severe")
+DEGRADATION_TYPES = ("motion_blur", "low_resolution", "jpeg_compression", "gaussian_noise")
+APPLY_TO_MODES = ("search_only", "template_only", "both_same", "both_different")
+
+if hasattr(Image, "Resampling"):
+    BICUBIC = Image.Resampling.BICUBIC
+else:
+    BICUBIC = Image.BICUBIC
+
+
+def _as_list(value) -> list[str]:
+    if isinstance(value, str):
+        return [value]
+    return [str(v) for v in value]
+
+
+def _to_uint8_rgb(image: np.ndarray) -> np.ndarray:
+    arr = np.asarray(image)
+    if arr.ndim == 2:
+        arr = np.repeat(arr[:, :, None], 3, axis=2)
+    if arr.ndim != 3 or arr.shape[2] not in (1, 3, 4):
+        raise ValueError("Expected image array with shape HxW, HxWx1, HxWx3, or HxWx4")
+    if arr.shape[2] == 1:
+        arr = np.repeat(arr, 3, axis=2)
+    if arr.shape[2] == 4:
+        arr = arr[:, :, :3]
+    if np.issubdtype(arr.dtype, np.floating):
+        max_value = float(np.nanmax(arr)) if arr.size else 1.0
+        if max_value <= 1.0:
+            arr = arr * 255.0
+    return np.clip(arr, 0, 255).astype(np.uint8)
+
+
+def _restore_dtype(arr: np.ndarray, reference: np.ndarray) -> np.ndarray:
+    if np.issubdtype(reference.dtype, np.floating):
+        if reference.size and float(np.nanmax(reference)) <= 1.0:
+            return (arr.astype(np.float32) / 255.0).astype(reference.dtype)
+        return arr.astype(reference.dtype)
+    return arr.astype(reference.dtype)
+
+
+def _pil_from_array(image: np.ndarray) -> Image.Image:
+    return Image.fromarray(_to_uint8_rgb(image), mode="RGB")
+
+
+def _array_from_pil(image: Image.Image, reference: np.ndarray) -> np.ndarray:
+    return _restore_dtype(np.asarray(image.convert("RGB")), np.asarray(reference))
+
+
+def motion_blur(image: np.ndarray, severity: str, rng: np.random.Generator) -> np.ndarray:
+    kernel_sizes = {"mild": 7, "medium": 13, "severe": 21}
+    kernel_size = kernel_sizes[severity]
+    radius = kernel_size // 2
+    angle = float(rng.uniform(0.0, 180.0))
+    theta = np.deg2rad(angle)
+    offsets = np.linspace(-radius, radius, kernel_size)
+    dx = np.rint(np.cos(theta) * offsets).astype(int)
+    dy = np.rint(np.sin(theta) * offsets).astype(int)
+
+    arr = _to_uint8_rgb(image).astype(np.float32)
+    padded = np.pad(arr, ((radius, radius), (radius, radius), (0, 0)), mode="edge")
+    height, width = arr.shape[:2]
+    accum = np.zeros_like(arr, dtype=np.float32)
+    for shift_x, shift_y in zip(dx, dy):
+        y0 = radius + shift_y
+        x0 = radius + shift_x
+        accum += padded[y0 : y0 + height, x0 : x0 + width, :]
+    out = np.clip(accum / float(kernel_size), 0, 255).astype(np.uint8)
+    return _restore_dtype(out, np.asarray(image))
+
+
+def low_resolution(image: np.ndarray, severity: str, rng: np.random.Generator) -> np.ndarray:
+    del rng
+    scales = {"mild": 0.75, "medium": 0.5, "severe": 0.25}
+    pil = _pil_from_array(image)
+    width, height = pil.size
+    scale = scales[severity]
+    low_size = (max(1, int(round(width * scale))), max(1, int(round(height * scale))))
+    out = pil.resize(low_size, BICUBIC).resize((width, height), BICUBIC)
+    return _array_from_pil(out, np.asarray(image))
+
+
+def jpeg_compression(image: np.ndarray, severity: str, rng: np.random.Generator) -> np.ndarray:
+    del rng
+    qualities = {"mild": 70, "medium": 40, "severe": 18}
+    buffer = BytesIO()
+    _pil_from_array(image).save(buffer, format="JPEG", quality=qualities[severity])
+    buffer.seek(0)
+    out = Image.open(buffer).convert("RGB")
+    return _array_from_pil(out, np.asarray(image))
+
+
+def gaussian_noise(image: np.ndarray, severity: str, rng: np.random.Generator) -> np.ndarray:
+    sigmas = {"mild": 8.0, "medium": 20.0, "severe": 40.0}
+    arr = _to_uint8_rgb(image).astype(np.float32)
+    out = np.clip(arr + rng.normal(0.0, sigmas[severity], size=arr.shape), 0, 255).astype(np.uint8)
+    return _restore_dtype(out, np.asarray(image))
+
+
+TRANSFORMS = {
+    "motion_blur": motion_blur,
+    "low_resolution": low_resolution,
+    "jpeg_compression": jpeg_compression,
+    "gaussian_noise": gaussian_noise,
+}
+
+
+class TrainingDegradationAugmentor:
+    """Config-driven degradation augmentor for cropped template/search images."""
+
+    def __init__(self, cfg):
+        self.enabled = bool(getattr(cfg, "ENABLE", False))
+        self.probability = float(getattr(cfg, "PROBABILITY", 0.0))
+        self.apply_to = str(getattr(cfg, "APPLY_TO", "search_only")).lower()
+        self.types = [t.lower() for t in _as_list(getattr(cfg, "TYPES", ["motion_blur", "low_resolution"]))]
+        self.severity = str(getattr(cfg, "SEVERITY", "medium")).lower()
+        self.rng = np.random.default_rng(int(getattr(cfg, "SEED", 42)))
+        self._sample = {"template": None, "search": None}
+        self._validate()
+
+    def _validate(self) -> None:
+        if self.apply_to not in APPLY_TO_MODES:
+            raise ValueError(f"Unsupported DATA.DEGRADATION.APPLY_TO: {self.apply_to}")
+        if self.severity not in SEVERITIES:
+            raise ValueError(f"Unsupported DATA.DEGRADATION.SEVERITY: {self.severity}")
+        if not 0.0 <= self.probability <= 1.0:
+            raise ValueError("DATA.DEGRADATION.PROBABILITY must be in [0, 1]")
+        unknown = [t for t in self.types if t not in DEGRADATION_TYPES]
+        if unknown:
+            raise ValueError(f"Unsupported DATA.DEGRADATION.TYPES: {unknown}")
+        if self.apply_to == "both_different" and len(set(self.types)) < 2:
+            raise ValueError("DATA.DEGRADATION.APPLY_TO=both_different requires at least two types")
+
+    def begin_sample(self) -> None:
+        self._sample = {"template": None, "search": None}
+        if not self.enabled or float(self.rng.random()) > self.probability:
+            return
+
+        if self.apply_to == "search_only":
+            self._sample["search"] = str(self.rng.choice(self.types))
+        elif self.apply_to == "template_only":
+            self._sample["template"] = str(self.rng.choice(self.types))
+        elif self.apply_to == "both_same":
+            choice = str(self.rng.choice(self.types))
+            self._sample["template"] = choice
+            self._sample["search"] = choice
+        elif self.apply_to == "both_different":
+            choices = self.rng.choice(self.types, size=2, replace=False).tolist()
+            self._sample["template"] = str(choices[0])
+            self._sample["search"] = str(choices[1])
+
+    def apply(self, images: list[np.ndarray], role: str) -> list[np.ndarray]:
+        degradation_type = self._sample.get(role)
+        if degradation_type is None:
+            return images
+
+        transformed = []
+        for image in images:
+            out = TRANSFORMS[degradation_type](image, self.severity, self.rng)
+            if out.shape[:2] != image.shape[:2]:
+                raise RuntimeError("Training degradation changed image size")
+            transformed.append(out)
+        return transformed
