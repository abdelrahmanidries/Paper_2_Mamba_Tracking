+    def compute_target_feature_consistency_loss(self, pred_dict, gt_dict):
+        if 'search_feat_rgssb' not in pred_dict:
+            raise KeyError("Target feature consistency requires pred_dict['search_feat_rgssb'].")
+        if 'search_feat_rgssb_clean' not in pred_dict:
+            raise KeyError("Target feature consistency requires pred_dict['search_feat_rgssb_clean'].")
+        if 'search_anno' not in gt_dict:
+            available_keys = sorted(list(gt_dict.keys())) if hasattr(gt_dict, "keys") else []
+            raise KeyError(
+                "Target feature consistency requires gt_dict['search_anno']. "
+                "Available data keys: {}".format(available_keys)
+            )
+
+        degraded_feat = pred_dict['search_feat_rgssb']
+        clean_feat = pred_dict['search_feat_rgssb_clean']
+        if degraded_feat.dim() != 3:
+            raise ValueError("Target feature consistency expects search features [B, HW, C].")
+        if degraded_feat.shape != clean_feat.shape:
+            raise ValueError(
+                "Target feature consistency feature shape mismatch: degraded={} clean={}".format(
+                    tuple(degraded_feat.shape), tuple(clean_feat.shape)
+                )
+            )
+
+        if bool(getattr(self.target_feature_consistency_cfg, "DETACH_CLEAN", True)):
+            clean_feat = clean_feat.detach()
+        if bool(getattr(self.target_feature_consistency_cfg, "NORMALIZE", True)):
+            degraded_feat = F.normalize(degraded_feat, dim=-1)
+            clean_feat = F.normalize(clean_feat, dim=-1)
+
+        search_anno = gt_dict['search_anno'][-1]
+        mask = self.build_target_feature_mask(
+            search_anno,
+            feat_len=degraded_feat.size(1),
+            device=degraded_feat.device,
+            dtype=degraded_feat.dtype,
+        )
+        loss_type = str(getattr(self.target_feature_consistency_cfg, "LOSS", "l1")).lower()
+        if loss_type == "l1":
+            feature_diff = torch.abs(degraded_feat - clean_feat)
+        elif loss_type == "mse":
+            feature_diff = (degraded_feat - clean_feat) ** 2
+        else:
+            raise ValueError("Unsupported TRAIN.TARGET_FEATURE_CONSISTENCY.LOSS: {}".format(loss_type))
+
+        target_feature_loss = (feature_diff * mask).sum() / (mask.sum() * degraded_feat.size(-1)).clamp(min=1.0)
+        if not torch.isfinite(target_feature_loss):
+            raise ValueError("Target feature consistency loss is not finite.")
+        pred_dict['target_feature_mask'] = mask
+        return target_feature_loss
