+    def compute_feature_consistency_loss(self, pred_dict):
+        if 'search_feat_rgssb' not in pred_dict:
+            raise KeyError("Feature consistency requires pred_dict['search_feat_rgssb'].")
+        if 'search_feat_rgssb_clean' not in pred_dict:
+            raise KeyError("Feature consistency requires pred_dict['search_feat_rgssb_clean'].")
+
+        degraded_feat = pred_dict['search_feat_rgssb']
+        clean_feat = pred_dict['search_feat_rgssb_clean']
+        if bool(getattr(self.feature_consistency_cfg, "DETACH_CLEAN", True)):
+            clean_feat = clean_feat.detach()
+        if bool(getattr(self.feature_consistency_cfg, "NORMALIZE", True)):
+            degraded_feat = F.normalize(degraded_feat, dim=-1)
+            clean_feat = F.normalize(clean_feat, dim=-1)
+
+        loss_type = str(getattr(self.feature_consistency_cfg, "LOSS", "l1")).lower()
+        if loss_type == "l1":
+            feature_loss = F.l1_loss(degraded_feat, clean_feat)
+        elif loss_type == "mse":
+            feature_loss = F.mse_loss(degraded_feat, clean_feat)
+        else:
+            raise ValueError("Unsupported TRAIN.FEATURE_CONSISTENCY.LOSS: {}".format(loss_type))
+        if not torch.isfinite(feature_loss):
