+    def build_target_feature_mask(self, search_anno, feat_len, device=None, dtype=None):
+        if search_anno.dim() != 2 or search_anno.size(-1) != 4:
+            raise ValueError("Target feature mask expects search_anno with shape [B, 4].")
+        grid_size = int(round(feat_len ** 0.5))
+        if grid_size * grid_size != feat_len:
+            raise ValueError("Target feature mask requires a square token grid, got feat_len={}.".format(feat_len))
+
+        device = device if device is not None else search_anno.device
+        dtype = dtype if dtype is not None else search_anno.dtype
+        boxes = search_anno.to(device=device, dtype=dtype).clamp(min=0.0, max=1.0)
+        x, y, w, h = boxes.unbind(dim=-1)
+        cx = (x + 0.5 * w).clamp(0.0, 1.0)
+        cy = (y + 0.5 * h).clamp(0.0, 1.0)
+        w = w.clamp(min=1.0 / grid_size, max=1.0)
+        h = h.clamp(min=1.0 / grid_size, max=1.0)
+
+        coords = (torch.arange(grid_size, device=device, dtype=dtype) + 0.5) / grid_size
+        yy, xx = torch.meshgrid(coords, coords, indexing="ij")
+        xx = xx.view(1, grid_size, grid_size)
+        yy = yy.view(1, grid_size, grid_size)
+
+        mask_type = str(getattr(self.target_feature_consistency_cfg, "MASK_TYPE", "gaussian")).lower()
+        background_weight = float(getattr(self.target_feature_consistency_cfg, "BACKGROUND_WEIGHT", 0.05))
+        background_weight = max(0.0, min(background_weight, 1.0))
+        if mask_type == "gaussian":
+            sigma_scale = float(getattr(self.target_feature_consistency_cfg, "SIGMA_SCALE", 0.5))
+            sigma_x = (w * sigma_scale).clamp(min=1.0 / grid_size).view(-1, 1, 1)
+            sigma_y = (h * sigma_scale).clamp(min=1.0 / grid_size).view(-1, 1, 1)
+            dist = ((xx - cx.view(-1, 1, 1)) / sigma_x) ** 2 + ((yy - cy.view(-1, 1, 1)) / sigma_y) ** 2
+            target_mask = torch.exp(-0.5 * dist)
+        elif mask_type == "binary":
+            x1 = x.view(-1, 1, 1)
+            y1 = y.view(-1, 1, 1)
+            x2 = (x + w).clamp(max=1.0).view(-1, 1, 1)
+            y2 = (y + h).clamp(max=1.0).view(-1, 1, 1)
+            target_mask = ((xx >= x1) & (xx <= x2) & (yy >= y1) & (yy <= y2)).to(dtype=dtype)
+        else:
+            raise ValueError("Unsupported TRAIN.TARGET_FEATURE_CONSISTENCY.MASK_TYPE: {}".format(mask_type))
+
+        mask = background_weight + (1.0 - background_weight) * target_mask
+        return mask.view(search_anno.size(0), feat_len, 1)
