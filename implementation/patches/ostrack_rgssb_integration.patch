@@ -0,0 +1,42 @@
+def _is_main_process():
+    try:
+        from lib.utils.misc import is_main_process
+
+        return is_main_process()
+    except Exception:
+        return True
+
+
+def summarize_trainable_parameters(net):
+    trainable_params = 0
+    frozen_params = 0
+    trainable_names = []
+    for name, param in net.named_parameters():
+        num_params = param.numel()
+        if param.requires_grad:
+            trainable_params += num_params
+            trainable_names.append(name)
+        else:
+            frozen_params += num_params
+    return trainable_params, frozen_params, trainable_names
+
+
+def apply_freeze_mode(net, cfg):
+    freeze_mode = getattr(cfg.TRAIN, "FREEZE_MODE", "none")
+    if freeze_mode == "none":
+        return summarize_trainable_parameters(net)
+    if freeze_mode == "rgssb_only":
+        for name, param in net.named_parameters():
+            param.requires_grad = "rgssb" in name
+        trainable_params, frozen_params, trainable_names = summarize_trainable_parameters(net)
+        if len(trainable_names) == 0:
+            raise ValueError("TRAIN.FREEZE_MODE=rgssb_only selected, but no rgssb parameters are trainable.")
+        if _is_main_process():
+            print("TRAIN.FREEZE_MODE=rgssb_only")
+            print("Trainable parameters: {}".format(trainable_params))
+            print("Frozen parameters: {}".format(frozen_params))
+            print("RG-SSB trainable parameter names:")
+            for name in trainable_names:
+                print(name)
+        return trainable_params, frozen_params, trainable_names
+    raise ValueError("Unsupported TRAIN.FREEZE_MODE: {}".format(freeze_mode))
