# Normalize text files across Windows/Linux
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.pdf binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.pth binary
*.pt binary
*.ckpt binary
*.zip binary
*.tar binary
*.gz binary
